# Example environment for mcp-cura.
#
# The binary does not read .env files automatically. Load this file from your
# shell, process manager, container runtime, or reverse proxy.

# HTTP transport
MCP_CURA_TRANSPORT=stdio
MCP_CURA_HTTP_HOST=127.0.0.1
MCP_CURA_HTTP_PORT=8765
MCP_CURA_HTTP_PATH=/mcp
MCP_CURA_HTTP_TOKEN=
MCP_CURA_HTTP_ALLOWED_HOSTS=
MCP_CURA_HTTP_ALLOWED_ORIGINS=
MCP_CURA_HTTP_ALLOW_UNAUTHENTICATED=false

# Engine
MCP_CURA_ENGINE_RUNNER=binary
MCP_CURA_ENGINE_BINARY=CuraEngine
MCP_CURA_DOCKER_IMAGE=
MCP_CURA_DOCKER_ARGS=
MCP_CURA_ENGINE_DEFINITIONS=
MCP_CURA_ENGINE_MODE=resolved_json
MCP_CURA_ENGINE_TIMEOUT_SECS=900
MCP_CURA_ENGINE_MAX_LOG_BYTES=1048576
MCP_CURA_ENGINE_VERBOSE=false

# Workspace and profiles
MCP_CURA_WORKSPACE=
MCP_CURA_IMPORT_ROOTS=
MCP_CURA_EXPORT_ROOTS=
MCP_CURA_MAX_IMPORT_BYTES=536870912
MCP_CURA_MAX_ARTIFACT_BYTES=1073741824
MCP_CURA_MAX_ARTIFACTS=10000
MCP_CURA_KEEP_JOBS=100
MCP_CURA_PROFILE_DIRS=
MCP_CURA_PROFILE_AUTO_DISCOVER=true
MCP_CURA_MAX_PROFILES=20000

# Policy
MCP_CURA_READ_ONLY=false
MCP_CURA_ALLOW_WORKSPACE_WRITES=true
MCP_CURA_ALLOW_SLICING=true
MCP_CURA_ALLOW_EXPORT=true
MCP_CURA_ALLOW_DELETE=true
MCP_CURA_MAX_HOTEND_TEMP=320.0
MCP_CURA_MAX_BED_TEMP=130.0
MCP_CURA_MAX_TRIANGLES=5000000
MCP_CURA_MAX_VOXEL_CELLS=64000000
MCP_CURA_MAX_CONCURRENT_JOBS=2
MCP_CURA_MAX_SLICE_SECS=900

# Approvals and logging
MCP_CURA_APPROVAL_MODE=in_band
MCP_CURA_APPROVAL_TTL_SECS=120
MCP_CURA_STATE_DIR=
MCP_CURA_LOG_LEVEL=info
MCP_CURA_AUDIT_LOG=
